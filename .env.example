# URL do web app do Apps Script, terminando em /exec.
# Copie em Implantar > Gerenciar implantações.
# O ID da pasta do Drive fica só em apps-script/Code.gs.
APPS_SCRIPT_URL=https://script.google.com/macros/s/COLE_O_ID_DA_IMPLANTACAO/exec

# O mesmo valor da propriedade UPLOAD_TOKEN no Apps Script.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPS_SCRIPT_TOKEN=
